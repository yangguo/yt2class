# Copy to .env in the directory where you run yt2class, then uncomment only
# the settings for the provider(s) you use. Exported shell variables win.
# Keep .env private; this sample contains no credentials.

# Direct YouTube video or playlist analysis: yt2class gemini-preview
# GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL=gemini-3.8-flash

# Frame/image analysis with an OpenAI-compatible vision endpoint.
# These endpoint/key/model settings also work with legacy `yt2class build --links`.
# Explicit analysis.provider and analysis.model in a course JSON take precedence
# for build-run/batch. The endpoint must accept image_url content parts.
# YT2CLASS_IMAGE_PROVIDER=openai-compatible
# YT2CLASS_IMAGE_ENDPOINT=https://your-provider.example/v1/chat/completions
# YT2CLASS_IMAGE_API_KEY=your-vision-api-key
# YT2CLASS_IMAGE_MODEL=your-vision-model
# YT2CLASS_IMAGE_JSON_MODE=auto
# YT2CLASS_IMAGE_TIMEOUT_SECONDS=300
