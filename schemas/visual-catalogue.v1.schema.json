{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "FrameOccurrence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "scene_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "asset_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "requested_seconds": {
          "minimum": 0,
          "title": "Requested Seconds",
          "type": "number"
        },
        "timestamp_seconds": {
          "minimum": 0,
          "title": "Timestamp Seconds",
          "type": "number"
        },
        "cluster_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cluster Id"
        },
        "reject_reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reject Reason"
        },
        "quality": {
          "$ref": "#/$defs/FrameQuality"
        }
      },
      "required": [
        "id",
        "scene_id",
        "asset_id",
        "requested_seconds",
        "timestamp_seconds",
        "quality"
      ],
      "title": "FrameOccurrence",
      "type": "object"
    },
    "FrameQuality": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "brightness": {
          "maximum": 1,
          "minimum": 0,
          "title": "Brightness",
          "type": "number"
        },
        "sharpness": {
          "maximum": 1,
          "minimum": 0,
          "title": "Sharpness",
          "type": "number"
        },
        "ocr_density": {
          "maximum": 1,
          "minimum": 0,
          "title": "Ocr Density",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height",
        "brightness",
        "sharpness",
        "ocr_density"
      ],
      "title": "FrameQuality",
      "type": "object"
    },
    "OcrRegion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "asset_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "parent_occurrence_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Parent Occurrence Id",
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "engine": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "id",
        "asset_id",
        "parent_occurrence_id",
        "bbox",
        "text",
        "engine",
        "confidence"
      ],
      "title": "OcrRegion",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "end_seconds": {
          "minimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "detector": {
          "enum": [
            "content",
            "adaptive"
          ],
          "title": "Detector",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start_seconds",
        "end_seconds",
        "detector"
      ],
      "title": "Scene",
      "type": "object"
    },
    "VisualAsset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "frame",
            "clip"
          ],
          "title": "Role",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "mime_type": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        }
      },
      "required": [
        "id",
        "role",
        "path",
        "sha256",
        "mime_type"
      ],
      "title": "VisualAsset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "title": "Scenes",
      "type": "array"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/VisualAsset"
      },
      "title": "Assets",
      "type": "array"
    },
    "occurrences": {
      "items": {
        "$ref": "#/$defs/FrameOccurrence"
      },
      "title": "Occurrences",
      "type": "array"
    },
    "ocr_regions": {
      "items": {
        "$ref": "#/$defs/OcrRegion"
      },
      "title": "Ocr Regions",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "source_id"
  ],
  "title": "VisualCatalogue",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "VisualCatalogue 1.0 structural schema. Occurrence/asset/OCR joins are enforced in Python."
}
