          },
          "title": "Assets",
          "type": "array"
        },
        "occurrences": {
          "items": {
            "$ref": "#/$defs/FrameOccurrence"
          },
          "title": "Occurrences",
          "type": "array"
        },
        "ocr_regions": {
          "items": {
            "$ref": "#/$defs/OcrRegion"
          },
          "title": "Ocr Regions",
          "type": "array"
        },
        "profile": {
          "anyOf": [
            {
              "enum": [
                "content",
                "adaptive"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        },
        "status": {
          "default": "complete",
          "enum": [
            "complete",
            "degraded",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "gaps": {
          "items": {
            "$ref": "#/$defs/VisualGap"
          },
          "title": "Gaps",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "source_id"
      ],
      "title": "VisualCatalogue",
      "type": "object"
    },
    "VisualGap": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "end_seconds": {
          "minimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "reason": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start_seconds",
        "end_seconds",
        "reason"
      ],
      "title": "VisualGap",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Hash",
      "type": "string"
    },
    "duration_seconds": {
      "exclusiveMinimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "source": {
      "$ref": "#/$defs/SourceManifest"
    },
    "transcript": {
      "$ref": "#/$defs/TranscriptDocument"
    },
    "visual": {
      "$ref": "#/$defs/VisualCatalogue"
    },
    "status": {
      "enum": [
        "complete",
        "degraded",
        "failed",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "gaps": {
      "items": {
        "$ref": "#/$defs/EvidenceGap"
      },
      "title": "Gaps",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/EvidenceArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "transcript_path": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transcript Path"
    },
    "visual_path": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Visual Path"
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "source_hash",
    "duration_seconds",
    "source",
    "transcript",
    "visual",
    "status"
  ],
  "title": "EvidenceBundle",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "EvidenceBundle 1.0 structural schema. Transcript/visual joins and explicit coverage gaps are enforced in Python."
}
