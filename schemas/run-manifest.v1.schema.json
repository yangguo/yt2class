{
  "$defs": {
    "RunUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "image_count": {
          "minimum": 0,
          "title": "Image Count",
          "type": "integer"
        },
        "video_seconds": {
          "minimum": 0,
          "title": "Video Seconds",
          "type": "number"
        },
        "estimated_usd": {
          "minimum": 0,
          "title": "Estimated Usd",
          "type": "number"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "image_count",
        "video_seconds",
        "estimated_usd"
      ],
      "title": "RunUsage",
      "type": "object"
    },
    "StageRecord": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "ingest",
            "extract_evidence",
            "outline",
            "analyze_segments",
            "reduce_knowledge",
            "edit_deck",
            "verify_claims",
            "bind_spec",
            "render"
          ],
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "complete",
            "degraded",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "cache_key": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Key"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "StageRecord",
      "type": "object"
    },
    "ToolVersions": {
      "additionalProperties": false,
      "properties": {
        "producer_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Producer Version",
          "type": "string"
        },
        "yt_dlp": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Yt Dlp"
        },
        "ffmpeg": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ffmpeg"
        },
        "provider": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "prompt": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        }
      },
      "required": [
        "producer_version"
      ],
      "title": "ToolVersions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "source_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "analysis_mode": {
      "enum": [
        "frames",
        "native-video",
        "hybrid"
      ],
      "title": "Analysis Mode",
      "type": "string"
    },
    "quality_status": {
      "enum": [
        "verified",
        "review_required",
        "incomplete",
        "evidence-only"
      ],
      "title": "Quality Status",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageRecord"
      },
      "minItems": 1,
      "title": "Stages",
      "type": "array"
    },
    "tool_versions": {
      "$ref": "#/$defs/ToolVersions"
    },
    "usage": {
      "$ref": "#/$defs/RunUsage"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "source_id",
    "analysis_mode",
    "quality_status",
    "stages",
    "tool_versions",
    "usage"
  ],
  "title": "RunManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "RunManifest 1.0 structural schema. Unique stage names are enforced in Python."
}
